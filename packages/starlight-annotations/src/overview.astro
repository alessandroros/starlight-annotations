---
// The overview page, added by the plugin at `/<overview>/` and once per
// locale (`/it/<overview>/`), so links from a localized sidebar or panel
// land in the reader's language. Every locale lists every note of the site.
// The list itself is drawn in the browser (client/overview.js), from the
// same API as the notes panel; here only the page titles are known.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import config from 'virtual:starlight-annotations/config';
import { strings } from './client/i18n.js';

export function getStaticPaths() {
  return [{ params: { locale: undefined } }, ...Object.keys(config.locales ?? {}).map((locale) => ({ params: { locale } }))];
}

const { locale } = Astro.params;
const T = strings(locale ? config.locales[locale] : config.lang, config.translations);
const docs = await getCollection('docs');
const titles = Object.fromEntries(docs.map((entry) => [entry.id, entry.data.title]));
---

<StarlightPage frontmatter={{ title: T.allNotes, description: T.overviewDescription, tableOfContents: false, pagefind: false, editUrl: false }}>
  <div class="annot-overview" data-titles={JSON.stringify(titles)}>
    <p>{T.loading}</p>
  </div>
  <script>
    import './client/overview.js';
  </script>
</StarlightPage>
